class_name Assets
## Loads and caches sprite textures from assets/sprites (generated by tools/make_assets.py).
## anchors.json holds, for every sprite, the pixel that sits on its world position.

static var _cache := {}
static var _anchors := {}

static func tex(name: String) -> Texture2D:
	if not _cache.has(name):
		_cache[name] = load("res://assets/sprites/%s.png" % name)
	return _cache[name]

## Sprite2D.offset (centered = false) that puts the sprite's anchor on its position.
static func off(name: String) -> Vector2:
	if _anchors.is_empty():
		var f := FileAccess.open("res://assets/anchors.json", FileAccess.READ)
		if f:
			_anchors = JSON.parse_string(f.get_as_text())
	if _anchors.has(name):
		var a: Array = _anchors[name]
		return Vector2(-a[0], -a[1])
	var t := tex(name)
	return Vector2(-t.get_width() * 0.5, -t.get_height())
